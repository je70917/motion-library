---
import type { MotionDef } from '../data/types';

interface Props {
  motion: MotionDef;
}

const { motion } = Astro.props;
---
<a
  href={`/motions/${motion.slug}`}
  class="blueprint card motion-card"
  style="cursor: pointer; text-decoration: none; color: inherit;"
>
  <Fragment set:html={motion.previewHtml} />
  <div class="card-kicker">{motion.label}</div>
  <p class="card-body">{motion.description}</p>
  <style set:html={motion.previewCss}></style>
</a>

<style>
  .motion-card {
    background: var(--color-bg);
    transition: background 0.15s ease-in-out;
  }
  .motion-card:hover {
    background: var(--color-neutral-100);
  }
</style>
