---
import '../styles/tokens.css';
// Nav is hidden for now — re-add `<Nav />` below the opening wrapper div to bring it back.
// import Nav from '../components/Nav.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A working set of micro-interactions for design and dev teams to browse and copy motion timing from.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body style="margin: 0;">
    <div style="background: var(--color-bg); min-height: 100vh; font-family: var(--font-body); color: var(--color-text);">
      <slot />
    </div>
  </body>
</html>
